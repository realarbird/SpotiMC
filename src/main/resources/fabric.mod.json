{
  "schemaVersion": 1,
  "id": "spotimc",
  "version": "${version}",
  "name": "SpotiMC",
  "description": "Client-side Spotify & Last.fm integration for Minecraft. Control your music, see what's playing with an in-game HUD, and share your song overhead with other players.",
  "authors": ["ARBird"],
  "contact": {
    "homepage": "https://modrinth.com/project/spotimc",
    "sources": "https://github.com/realarbird/SpotiMC",
    "issues": "https://github.com/realarbird/SpotiMC/issues"
  },
  "license": "GPL-3.0",
  "icon": "assets/spotimc/icon.png",
  "environment": "*",
  "entrypoints": {
    "main": ["com.realarbird.spotimc.SpotiMCMod"],
    "client": ["com.realarbird.spotimc.SpotiMCClient"]
  },
  "mixins": ["spotimc.mixins.json"],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.2",
    "java": ">=25",
    "fabric-api": "*"
  }
}
